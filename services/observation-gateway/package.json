{
  "name": "@pai/observation-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate.mjs --check",
    "generate": "tsc -p tsconfig.json && node scripts/generate.mjs",
    "generate:check": "tsc -p tsconfig.json && node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run generate:check && node --test test/*.test.mjs"
  },
  "dependencies": { "@pai/auth": "workspace:*", "@pai/contracts": "workspace:*", "@pai/eventing": "workspace:*", "@pai/service-kit": "workspace:*", "@sinclair/typebox": "catalog:" },
  "devDependencies": { "typescript": "catalog:" }
}
