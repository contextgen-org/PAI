                {
                  "const": "local",
                  "type": "string"
                },
                {
                  "const": "dev",
                  "type": "string"
                },
                {
                  "const": "staging",
                  "type": "string"
                },
                {
                  "const": "prod",
                  "type": "string"
                }
              ]
            },
            "release_channel": {
              "$id": "urn:pai:shared:release-channel:v1",
              "anyOf": [
                {
                  "const": "stable",
                  "type": "string"
                },
                {
                  "const": "canary",
                  "type": "string"
                }
              ]
            },
            "owner_agent_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "requested_catalog_version": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "effective_catalog_version": {
