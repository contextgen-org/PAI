            "security_revocation_epoch": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "policy_input_hash": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "valid_until": {
              "format": "date-time",
              "type": "string"
            },
            "resolved_skills": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "resolution_id",
                  "skill_id",
                  "skill_key",
                  "version_id",
                  "version",
                  "package_digest",
                  "manifest_digest",
                  "runtime_target",
