                  },
                  "skill_key": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  "version_id": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  "version": {
                    "minLength": 1,
                    "maxLength": 128,
                    "type": "string"
                  },
                  "package_digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "manifest_digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "runtime_target": {
                    "const": "filesystem_bundle.v1",
                    "type": "string"
                  },
                  "granted_capability_refs": {
                    "maxItems": 1024,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "maxLength": 256,
                      "type": "string"
                    }
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "valid_until": {
                    "format": "date-time",
                    "type": "string"
                  }
                }
              }
            },
            "degradation_notes": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "skill_key",
                  "reason"
                ],
                "properties": {
                  "skill_key": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "const": "not_found",
                        "type": "string"
                      },
                      {
                        "const": "activation_disabled",
                        "type": "string"
                      },
                      {
                        "const": "permission_denied",
                        "type": "string"
                      },
                      {
                        "const": "version_revoked",
                        "type": "string"
                      }
                    ]
                  }
                }
              }
            },
            "duplicate_replayed": {
              "type": "boolean"
            }
          }
        },
        "trace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        }
