{
  "$id": "urn:pai:skill-registry:resolve:v1",
  "anyOf": [
    {
      "$id": "urn:pai:skill-registry:resolve-request:v1",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "runtime_run_id",
        "start_attempt_no",
        "workspace_id",
        "bot_id",
        "deployment_environment",
        "release_channel",
        "owner_agent_id",
        "expected_catalog_version",
        "catalog_as_of",
        "policy_input_ref",
        "policy_input_hash",
        "skills",
        "idempotency_key",
        "trace_id"
      ],
      "properties": {
        "schema_version": {
          "const": "skill_resolution_request.v1",
          "type": "string"
        },
        "runtime_run_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "start_attempt_no": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "workspace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "bot_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "deployment_environment": {
          "$id": "urn:pai:shared:deployment-environment:v1",
          "anyOf": [
            {
              "const": "local",
              "type": "string"
            },
            {
              "const": "dev",
              "type": "string"
            },
            {
              "const": "staging",
              "type": "string"
            },
            {
              "const": "prod",
              "type": "string"
            }
          ]
        },
        "release_channel": {
          "$id": "urn:pai:shared:release-channel:v1",
          "anyOf": [
            {
              "const": "stable",
              "type": "string"
            },
            {
              "const": "canary",
              "type": "string"
            }
          ]
        },
        "owner_agent_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "expected_catalog_version": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "catalog_as_of": {
          "format": "date-time",
          "type": "string"
        },
        "policy_input_ref": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "policy_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "skills": {
          "minItems": 1,
          "maxItems": 512,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "version_constraint",
              "required"
            ],
            "properties": {
              "name": {
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
                "maxLength": 64,
                "type": "string"
              },
              "version_constraint": {
                "const": "catalog_revision",
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "idempotency_key": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "details",
        "trace_id"
      ],
      "properties": {
        "code": {
          "const": "skill_resolution_succeeded",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "retryable": {
          "const": false,
          "type": "boolean"
        },
        "details": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schema_version",
            "resolution_attempt_id",
            "runtime_run_id",
            "start_attempt_no",
            "workspace_id",
            "bot_id",
            "deployment_environment",
