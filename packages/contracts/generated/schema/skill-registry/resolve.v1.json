          ],
          "properties": {
            "schema_version": {
              "const": "skill_resolution_response.v1",
              "type": "string"
            },
            "resolution_attempt_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "runtime_run_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "start_attempt_no": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "workspace_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "bot_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "deployment_environment": {
              "$id": "urn:pai:shared:deployment-environment:v1",
