{
  "$id": "urn:pai:meta:experience-query:v1",
  "anyOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "trigger_process_id",
        "workspace_id",
        "bot_id",
        "owner_agent_id",
        "deployment_environment",
        "release_channel"
      ],
      "properties": {
        "trigger_process_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "bot_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "owner_agent_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "deployment_environment": {
          "anyOf": [
            {
              "const": "local",
              "type": "string"
            },
            {
              "const": "dev",
              "type": "string"
            },
            {
              "const": "staging",
              "type": "string"
            },
            {
              "const": "prod",
              "type": "string"
            }
          ]
        },
        "release_channel": {
          "anyOf": [
            {
              "const": "stable",
              "type": "string"
            },
            {
              "const": "canary",
              "type": "string"
            }
          ]
        },
        "trace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        }
      }
    },
    {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "trigger_process_id",
            "bot_id",
            "trace_id",
            "experience_record_id",
            "status",
            "summary",
            "execution_summary",
            "evidence_refs",
            "quality_score",
            "created_at"
          ],
          "properties": {
            "trigger_process_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "bot_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "trace_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "experience_record_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "status": {
              "const": "available",
              "type": "string"
            },
            "summary": {
              "minLength": 1,
              "maxLength": 16384,
              "type": "string"
            },
            "execution_summary": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "task_stages",
                "major_results",
                "failure_summaries",
                "artifact_refs"
              ],
              "properties": {
                "task_stages": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  }
                },
                "major_results": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "failure_summaries": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "artifact_refs": {
                  "maxItems": 10000,
                  "uniqueItems": true,
                  "type": "array",
                  "items": {
                    "minLength": 3,
                    "maxLength": 2048,
                    "pattern": "^(memory_point|trigger_process|trigger_event|user_feedback|developer_note|system_event|artifact|tool_result):[^\\r\\n]+$",
                    "type": "string"
                  }
                }
              }
            },
            "evidence_refs": {
              "maxItems": 10000,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 3,
                "maxLength": 2048,
                "pattern": "^(memory_point|trigger_process|trigger_event|user_feedback|developer_note|system_event|artifact|tool_result):[^\\r\\n]+$",
                "type": "string"
              }
            },
            "quality_score": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "minLength": 20,
              "maxLength": 30,
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "trigger_process_id",
            "bot_id",
            "trace_id",
            "experience_record_id",
            "status",
            "summary",
            "execution_summary",
            "evidence_refs",
            "quality_score",
            "created_at"
          ],
          "properties": {
            "trigger_process_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "bot_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "trace_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "experience_record_id": {
              "type": "null"
            },
            "status": {
              "anyOf": [
                {
                  "const": "pending",
                  "type": "string"
                },
                {
                  "const": "not_found",
                  "type": "string"
                }
              ]
            },
            "summary": {
              "type": "null"
            },
            "execution_summary": {
              "type": "null"
            },
            "evidence_refs": {
              "maxItems": 0,
              "type": "array",
              "items": {
                "minLength": 3,
                "maxLength": 2048,
                "pattern": "^(memory_point|trigger_process|trigger_event|user_feedback|developer_note|system_event|artifact|tool_result):[^\\r\\n]+$",
                "type": "string"
              }
            },
            "quality_score": {
              "type": "null"
            },
            "created_at": {
              "type": "null"
            }
          }
        }
      ]
    }
  ]
}
