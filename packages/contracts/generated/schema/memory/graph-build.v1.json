{
  "$id": "urn:pai:memory:graph-build:v1",
  "anyOf": [
    {
      "$id": "urn:pai:memory:graph-build-request:v1",
      "additionalProperties": false,
      "maxCanonicalJsonBytes": 65536,
      "type": "object",
      "required": [
        "schema_version",
        "bot_id",
        "seed_memory_point_ids",
        "idempotency_key",
        "policy_snapshot_id",
        "capability_token"
      ],
      "properties": {
        "schema_version": {
          "const": "memory.association_graph.v1",
          "type": "string"
        },
        "bot_id": {
          "minLength": 1,
          "maxUtf8Bytes": 256,
          "type": "string"
        },
        "seed_memory_point_ids": {
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxUtf8Bytes": 256,
            "type": "string"
          }
        },
        "seed_series_ids": {
          "maxItems": 1000,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxUtf8Bytes": 256,
            "type": "string"
          }
        },
        "seed_subject_keys": {
          "maxItems": 1000,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxUtf8Bytes": 256,
            "type": "string"
          }
        },
        "edge_types": {
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "co_occurs",
                "type": "string"
              },
              {
                "const": "relates_to",
                "type": "string"
              },
              {
                "const": "supports",
                "type": "string"
              },
              {
                "const": "contradicts",
                "type": "string"
              },
              {
                "const": "supersedes",
                "type": "string"
              }
            ]
          }
        },
        "max_hops": {
          "minimum": 0,
          "maximum": 2,
          "type": "integer"
        },
        "max_nodes": {
          "minimum": 1,
          "maximum": 10000,
          "type": "integer"
        },
        "max_edges": {
          "minimum": 1,
          "maximum": 50000,
          "type": "integer"
        },
        "idempotency_key": {
          "minLength": 1,
          "maxUtf8Bytes": 128,
          "type": "string"
        },
        "policy_snapshot_id": {
          "minLength": 1,
          "maxUtf8Bytes": 256,
          "type": "string"
        },
        "capability_token": {
          "minLength": 1,
          "maxUtf8Bytes": 16384,
          "type": "string"
        }
      }
    },
    {
      "$id": "urn:pai:memory:graph-build-response:v1",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "graph_id",
        "graph_revision",
        "nodes",
        "edges",
        "paths",
        "actual_budget",
        "truncated",
        "duplicate_replayed"
      ],
      "properties": {
        "schema_version": {
          "const": "memory.association_graph.v1",
          "type": "string"
        },
        "graph_id": {
          "minLength": 1,
          "maxUtf8Bytes": 256,
          "type": "string"
        },
        "graph_revision": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "nodes": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "type",
              "id",
              "redaction_status"
            ],
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "const": "memory_point",
                    "type": "string"
                  },
                  {
                    "const": "memory_series",
                    "type": "string"
                  },
                  {
                    "const": "subject",
                    "type": "string"
                  }
                ]
              },
              "id": {
                "minLength": 1,
                "maxUtf8Bytes": 256,
                "type": "string"
              },
              "redaction_status": {
                "anyOf": [
                  {
                    "const": "redacted",
                    "type": "string"
                  },
                  {
                    "const": "not_required",
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "edges": {
          "maxItems": 50000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "edge_id",
              "type",
              "from",
              "to",
              "confidence"
            ],
            "properties": {
              "edge_id": {
                "minLength": 1,
                "maxUtf8Bytes": 256,
                "type": "string"
              },
              "type": {
                "anyOf": [
                  {
                    "const": "co_occurs",
                    "type": "string"
                  },
                  {
                    "const": "relates_to",
                    "type": "string"
                  },
                  {
                    "const": "supports",
                    "type": "string"
                  },
                  {
                    "const": "contradicts",
                    "type": "string"
                  },
                  {
                    "const": "supersedes",
                    "type": "string"
                  }
                ]
              },
              "from": {
                "minLength": 1,
                "maxUtf8Bytes": 256,
                "type": "string"
              },
              "to": {
                "minLength": 1,
                "maxUtf8Bytes": 256,
                "type": "string"
              },
              "confidence": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        },
        "paths": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "node_ids",
              "edge_ids",
              "hop_count",
              "path_score"
            ],
            "properties": {
              "node_ids": {
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "maxUtf8Bytes": 256,
                  "type": "string"
                }
              },
              "edge_ids": {
                "maxItems": 2,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "maxUtf8Bytes": 256,
                  "type": "string"
                }
              },
              "hop_count": {
                "minimum": 0,
                "maximum": 2,
                "type": "integer"
              },
              "path_score": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        },
        "actual_budget": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "max_hops",
            "nodes_visited",
            "edges_visited"
          ],
          "properties": {
            "max_hops": {
              "minimum": 0,
              "maximum": 2,
              "type": "integer"
            },
            "nodes_visited": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "edges_visited": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "partial_reason": {
          "anyOf": [
            {
              "const": "graph_budget_exceeded",
              "type": "string"
            },
            {
              "const": "graph_timeout",
              "type": "string"
            }
          ]
        },
        "duplicate_replayed": {
          "type": "boolean"
        }
      }
    }
  ]
}
