{
  "$id": "urn:pai:knowthat:candidate-review-result:v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "review_id",
    "suggestion_id",
    "candidate_id",
    "target_candidate_version",
    "status",
    "decision",
    "linkage_check_ids",
    "duplicate_replayed",
    "reason_code"
  ],
  "properties": {
    "review_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "suggestion_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "target_candidate_version": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "rejected",
          "type": "string"
        },
        {
          "const": "stale_candidate_version",
          "type": "string"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "const": "promote",
          "type": "string"
        },
        {
          "const": "keep_candidate",
          "type": "string"
        },
        {
          "const": "reject",
          "type": "string"
        },
        {
          "const": "expire",
          "type": "string"
        },
        {
          "const": "request_feedback",
          "type": "string"
        }
      ]
    },
    "linkage_check_ids": {
      "maxItems": 256,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
        "type": "string"
      }
    },
    "feedback_request_suggestion": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "candidate_id",
        "dedupe_scope_ref",
        "question_key",
        "question_payload",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "conflict_id": {
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "dedupe_scope_ref": {
          "minLength": 3,
          "maxLength": 1024,
          "pattern": "^(?:candidate|conflict):[^\\r\\n]+$",
          "type": "string"
        },
        "question_key": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "question_payload": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$id": "T1",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "T1"
                  }
                },
                {
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "$ref": "T1"
                    }
                  }
                }
              ]
            }
          }
        },
        "reason": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "evidence_refs": {
          "maxItems": 64,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "$id": "urn:pai:shared:typed-evidence-ref:v1",
            "minLength": 3,
            "pattern": "^(memory_point|trigger_process|trigger_event|user_feedback|developer_note|system_event|artifact|tool_result):[^\\r\\n]+$",
            "type": "string"
          }
        }
      }
    },
    "candidate_version_after": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "duplicate_replayed": {
      "type": "boolean"
    },
    "reason_code": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    }
  }
}
