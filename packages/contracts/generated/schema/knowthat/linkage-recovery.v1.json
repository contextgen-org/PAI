{
  "$id": "urn:pai:knowthat:linkage-recovery:v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "workspace_id",
    "bot_id",
    "owner_agent_id",
    "deployment_environment",
    "release_channel",
    "linkage_job_id",
    "expected_job_version",
    "recovery_action",
    "reason",
    "idempotency_key",
    "request_hash",
    "trace_id"
  ],
  "properties": {
    "schema_version": {
      "const": "knowthat.linkage_recovery.v1",
      "type": "string"
    },
    "workspace_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "bot_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "owner_agent_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "deployment_environment": {
      "$id": "urn:pai:shared:deployment-environment:v1",
      "anyOf": [
        {
          "const": "local",
          "type": "string"
        },
        {
          "const": "dev",
          "type": "string"
        },
        {
          "const": "staging",
          "type": "string"
        },
        {
          "const": "prod",
          "type": "string"
        }
      ]
    },
    "release_channel": {
      "$id": "urn:pai:shared:release-channel:v1",
      "anyOf": [
        {
          "const": "stable",
          "type": "string"
        },
        {
          "const": "canary",
          "type": "string"
        }
      ]
    },
    "linkage_job_id": {
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "expected_job_version": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "recovery_action": {
      "anyOf": [
        {
          "const": "replay",
          "type": "string"
        },
        {
          "const": "repair",
          "type": "string"
        }
      ]
    },
    "reason": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    }
  }
}
