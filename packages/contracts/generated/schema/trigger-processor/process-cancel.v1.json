{
  "$id": "urn:pai:trigger-processor:process-cancel-request:v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "idempotency_key",
    "reason"
  ],
  "properties": {
    "idempotency_key": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:[._-][a-z0-9_]+)*$",
      "type": "string"
    }
  }
}
