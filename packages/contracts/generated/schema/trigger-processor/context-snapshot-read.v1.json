        },
        "canonical_bytes_sha256": {
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "content_length_bytes": {
          "minimum": 1,
          "maximum": 16777216,
          "type": "integer"
        },
        "retention_until": {
          "format": "date-time",
          "type": "string"
        },
        "redaction_state": {
          "anyOf": [
            {
              "const": "not_required",
              "type": "string"
