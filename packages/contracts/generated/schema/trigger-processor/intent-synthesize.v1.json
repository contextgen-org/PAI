{
  "$id": "urn:pai:trigger-processor:intent-synthesize:v1",
  "anyOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "trigger_process_id",
        "workspace_id",
        "bot_id",
        "owner_agent_id",
        "deployment_environment",
        "release_channel",
        "trigger_ref",
        "intent_version",
        "context_snapshot_ref",
        "context_snapshot_version",
        "context_snapshot_hash",
        "intent_policy_snapshot",
        "idempotency_key",
        "trace_id"
      ],
      "properties": {
        "schema_version": {
          "const": "intent_synthesize_request.v1",
          "type": "string"
        },
        "trigger_process_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "bot_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "owner_agent_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "deployment_environment": {
          "$id": "urn:pai:shared:deployment-environment:v1",
          "anyOf": [
            {
              "const": "local",
              "type": "string"
            },
            {
              "const": "dev",
              "type": "string"
            },
            {
              "const": "staging",
              "type": "string"
            },
            {
              "const": "prod",
              "type": "string"
            }
          ]
        },
        "release_channel": {
          "$id": "urn:pai:shared:release-channel:v1",
          "anyOf": [
            {
              "const": "stable",
              "type": "string"
            },
            {
              "const": "canary",
              "type": "string"
            }
          ]
        },
        "trigger_ref": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "intent_version": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "context_snapshot_ref": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "context_snapshot_version": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "context_snapshot_hash": {
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "intent_policy_snapshot": {
          "$id": "urn:pai:trigger-processor:intent-policy-input-snapshot:v1",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schema_version",
            "snapshot_ref",
            "workspace_id",
            "bot_id",
            "owner_agent_id",
            "deployment_environment",
            "release_channel",
            "bot_policy_revision_id",
            "personality_ref",
            "personality_version",
            "personality_hash",
            "safety_boundaries_ref",
            "safety_boundaries_version",
            "safety_boundaries_hash",
            "tool_permission_profile_ref",
            "tool_permission_profile_revision",
            "tool_permission_profile_hash",
            "tool_policy_epoch",
            "catalog_version",
            "catalog_as_of",
            "security_revocation_epoch",
            "skill_permission_summary_ref",
            "skill_permission_summary_hash",
            "snapshot_hash"
          ],
          "properties": {
            "schema_version": {
              "const": "intent_policy_input_snapshot.v1",
              "type": "string"
            },
            "snapshot_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "workspace_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "bot_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "owner_agent_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "deployment_environment": {
              "$id": "urn:pai:shared:deployment-environment:v1",
              "anyOf": [
                {
                  "const": "local",
                  "type": "string"
                },
                {
                  "const": "dev",
                  "type": "string"
                },
                {
                  "const": "staging",
                  "type": "string"
                },
                {
                  "const": "prod",
                  "type": "string"
                }
              ]
            },
            "release_channel": {
              "$id": "urn:pai:shared:release-channel:v1",
              "anyOf": [
                {
                  "const": "stable",
                  "type": "string"
                },
                {
                  "const": "canary",
                  "type": "string"
                }
              ]
            },
            "bot_policy_revision_id": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "personality_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "personality_version": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "personality_hash": {
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "safety_boundaries_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "safety_boundaries_version": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "safety_boundaries_hash": {
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "tool_permission_profile_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "tool_permission_profile_revision": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "tool_permission_profile_hash": {
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "tool_policy_epoch": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "catalog_version": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "catalog_as_of": {
              "minLength": 20,
              "maxLength": 30,
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
              "type": "string"
            },
            "security_revocation_epoch": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "skill_permission_summary_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "skill_permission_summary_hash": {
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "snapshot_hash": {
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "idempotency_key": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "trace_id",
        "details"
      ],
      "properties": {
        "code": {
          "const": "intent_synthesized",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "retryable": {
          "const": false,
          "type": "boolean"
        },
        "trace_id": {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        "details": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "intent_ref",
            "intent_version",
            "intent_schema_version",
            "structured_intent_hash",
            "structured_intent",
            "policy_decision",
            "intent_policy_snapshot"
          ],
          "properties": {
            "intent_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "intent_version": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "intent_schema_version": {
              "const": "structured_intent.v1",
              "type": "string"
            },
            "structured_intent_hash": {
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "structured_intent": {
              "$id": "urn:pai:trigger-processor:structured-intent:v1",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "goal",
                "user_need",
                "response_style",
                "action_plan",
                "required_skills",
                "memory_followups",
                "safety_notes",
                "requires_confirmation"
              ],
              "properties": {
                "goal": {
                  "minLength": 1,
                  "maxLength": 16384,
                  "type": "string"
                },
                "user_need": {
                  "minLength": 1,
                  "maxLength": 16384,
                  "type": "string"
                },
                "response_style": {
                  "minLength": 1,
                  "maxLength": 4096,
                  "type": "string"
                },
                "action_plan": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "step",
                      "action_type",
                      "action"
                    ],
                    "properties": {
                      "step": {
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      },
                      "action_type": {
                        "anyOf": [
                          {
                            "const": "respond",
                            "type": "string"
                          },
                          {
                            "const": "tool_use",
                            "type": "string"
                          },
                          {
                            "const": "ask_confirmation",
                            "type": "string"
                          },
                          {
                            "const": "wait",
                            "type": "string"
                          },
                          {
                            "const": "no_op",
                            "type": "string"
                          }
                        ]
                      },
                      "action": {
                        "minLength": 1,
                        "maxLength": 16384,
                        "type": "string"
                      },
                      "candidate_tool": {
                        "minLength": 1,
                        "maxLength": 512,
                        "type": "string"
                      },
                      "candidate_skill": {
                        "minLength": 1,
                        "maxLength": 512,
                        "type": "string"
                      },
                      "capability_scope_required": {
                        "maxItems": 10000,
                        "uniqueItems": true,
                        "type": "array",
                        "items": {
                          "minLength": 1,
                          "maxLength": 512,
                          "type": "string"
                        }
                      },
                      "risk_level": {
                        "anyOf": [
                          {
                            "const": "low",
                            "type": "string"
                          },
                          {
                            "const": "medium",
                            "type": "string"
                          },
                          {
                            "const": "high",
                            "type": "string"
                          }
                        ]
                      },
                      "requires_confirmation": {
                        "type": "boolean"
                      },
                      "depends_on": {
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      },
                      "condition": {
                        "minLength": 1,
                        "maxLength": 4096,
                        "type": "string"
                      },
                      "fallback": {
                        "minLength": 1,
                        "maxLength": 4096,
                        "type": "string"
                      }
                    }
                  }
                },
                "required_skills": {
                  "maxItems": 10000,
                  "uniqueItems": true,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  }
                },
                "memory_followups": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "execution_mode": {
                  "const": "deferred_timer_parent",
                  "type": "string"
                },
                "deferred_instruction": {
                  "minLength": 1,
                  "maxLength": 16384,
                  "type": "string"
                },
                "deferred_fire_at": {
                  "minLength": 20,
                  "maxLength": 30,
                  "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
                  "type": "string"
                },
                "safety_notes": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "degradation_notes": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "requires_confirmation": {
                  "type": "boolean"
                }
              }
            },
            "policy_decision": {
              "anyOf": [
                {
                  "const": "allow",
                  "type": "string"
                },
                {
                  "const": "require_confirmation",
                  "type": "string"
                },
                {
                  "const": "deny",
                  "type": "string"
                }
              ]
            },
            "intent_policy_snapshot": {
              "$id": "urn:pai:trigger-processor:intent-policy-input-snapshot:v1",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "schema_version",
                "snapshot_ref",
                "workspace_id",
                "bot_id",
                "owner_agent_id",
                "deployment_environment",
                "release_channel",
                "bot_policy_revision_id",
                "personality_ref",
                "personality_version",
                "personality_hash",
                "safety_boundaries_ref",
                "safety_boundaries_version",
                "safety_boundaries_hash",
                "tool_permission_profile_ref",
                "tool_permission_profile_revision",
                "tool_permission_profile_hash",
                "tool_policy_epoch",
                "catalog_version",
                "catalog_as_of",
                "security_revocation_epoch",
                "skill_permission_summary_ref",
                "skill_permission_summary_hash",
                "snapshot_hash"
              ],
              "properties": {
                "schema_version": {
                  "const": "intent_policy_input_snapshot.v1",
                  "type": "string"
                },
                "snapshot_ref": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "workspace_id": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "bot_id": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "owner_agent_id": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "deployment_environment": {
                  "$id": "urn:pai:shared:deployment-environment:v1",
                  "anyOf": [
                    {
                      "const": "local",
                      "type": "string"
                    },
                    {
                      "const": "dev",
                      "type": "string"
                    },
                    {
                      "const": "staging",
                      "type": "string"
                    },
                    {
                      "const": "prod",
                      "type": "string"
                    }
                  ]
                },
                "release_channel": {
                  "$id": "urn:pai:shared:release-channel:v1",
                  "anyOf": [
                    {
                      "const": "stable",
                      "type": "string"
                    },
                    {
                      "const": "canary",
                      "type": "string"
                    }
                  ]
                },
                "bot_policy_revision_id": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "personality_ref": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "personality_version": {
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "personality_hash": {
                  "minLength": 71,
                  "maxLength": 71,
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "safety_boundaries_ref": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "safety_boundaries_version": {
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "safety_boundaries_hash": {
                  "minLength": 71,
                  "maxLength": 71,
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "tool_permission_profile_ref": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "tool_permission_profile_revision": {
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "tool_permission_profile_hash": {
                  "minLength": 71,
                  "maxLength": 71,
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "tool_policy_epoch": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "catalog_version": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "catalog_as_of": {
                  "minLength": 20,
                  "maxLength": 30,
                  "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
                  "type": "string"
                },
                "security_revocation_epoch": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "skill_permission_summary_ref": {
                  "minLength": 1,
                  "maxLength": 512,
                  "type": "string"
                },
                "skill_permission_summary_hash": {
                  "minLength": 71,
                  "maxLength": 71,
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "snapshot_hash": {
                  "minLength": 71,
                  "maxLength": 71,
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
