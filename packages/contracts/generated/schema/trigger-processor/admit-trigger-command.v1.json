{
  "$id": "urn:pai:trigger-processor:admit-trigger-command:v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "trigger_id",
    "process_id",
    "scope",
    "payload",
    "dedupe_key",
    "request_hash",
    "idempotency_key",
    "is_catch_up",
    "explicit_interrupt",
    "source",
    "trace_id"
  ],
  "properties": {
    "trigger_id": {
      "minLength": 1,
      "type": "string"
    },
    "process_id": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scope_kind",
        "workspace_id",
        "bot_id",
        "owner_agent_id",
        "deployment_environment",
        "release_channel"
      ],
      "properties": {
        "scope_kind": {
          "const": "bot",
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        },
        "bot_id": {
          "minLength": 1,
          "type": "string"
        },
        "owner_agent_id": {
          "minLength": 1,
          "type": "string"
        },
        "deployment_environment": {
          "$id": "urn:pai:shared:deployment-environment:v1",
          "anyOf": [
            {
              "const": "local",
              "type": "string"
            },
            {
              "const": "dev",
              "type": "string"
            },
            {
              "const": "staging",
              "type": "string"
            },
            {
              "const": "prod",
              "type": "string"
            }
          ]
        },
        "release_channel": {
          "$id": "urn:pai:shared:release-channel:v1",
          "anyOf": [
            {
              "const": "stable",
              "type": "string"
            },
            {
              "const": "canary",
              "type": "string"
            }
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "dedupe_key": {
      "minLength": 1,
      "type": "string"
    },
    "request_hash": {
      "minLength": 1,
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "is_catch_up": {
      "type": "boolean"
    },
    "explicit_interrupt": {
      "type": "boolean"
    },
    "source": {
      "anyOf": [
        {
          "const": "chat",
          "type": "string"
        },
        {
          "const": "notification",
          "type": "string"
        },
        {
          "const": "timer",
          "type": "string"
        }
      ]
    },
    "trace_id": {
      "minLength": 1,
      "type": "string"
    }
  }
}
