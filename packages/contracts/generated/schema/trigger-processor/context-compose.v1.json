                            "minLength": 20,
                            "maxLength": 35,
                            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "source_version": {
                        "anyOf": [
                          {
                            "minLength": 1,
                            "maxLength": 512,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
