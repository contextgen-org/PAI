{
  "$id": "urn:pai:trigger-processor:context-snapshot:v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "trigger_process_id",
    "context_version",
    "workspace_id",
    "bot_id",
    "owner_agent_id",
    "deployment_environment",
    "release_channel",
    "pinned_facts",
    "memory_context",
    "skill_catalog",
    "environment",
    "history",
    "source_status",
    "assembly_notes",
    "snapshot_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "context_snapshot.v1",
      "type": "string"
    },
    "trigger_process_id": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "context_version": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "workspace_id": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "bot_id": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "owner_agent_id": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "deployment_environment": {
      "$id": "urn:pai:shared:deployment-environment:v1",
      "anyOf": [
        {
          "const": "local",
          "type": "string"
        },
        {
          "const": "dev",
          "type": "string"
        },
        {
          "const": "staging",
          "type": "string"
        },
        {
          "const": "prod",
          "type": "string"
        }
      ]
    },
    "release_channel": {
      "$id": "urn:pai:shared:release-channel:v1",
      "anyOf": [
        {
          "const": "stable",
          "type": "string"
        },
        {
          "const": "canary",
          "type": "string"
        }
      ]
    },
    "pinned_facts": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "version",
          "summary"
        ],
        "properties": {
          "ref": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "hash": {
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "maxLength": 16384,
            "type": "string"
          }
        }
      }
    },
    "memory_context": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "version",
          "summary"
        ],
        "properties": {
          "ref": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "hash": {
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "maxLength": 16384,
            "type": "string"
          }
        }
      }
    },
    "skill_catalog": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "catalog_version",
            "catalog_as_of",
            "items"
          ],
          "properties": {
            "catalog_version": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "catalog_as_of": {
              "minLength": 20,
              "maxLength": 35,
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
              "type": "string"
            },
            "items": {
              "maxItems": 10000,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "skill_key",
                  "name",
                  "description",
                  "active_version",
                  "package_digest",
                  "manifest_digest",
                  "runtime_target"
                ],
                "properties": {
                  "skill_key": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  "name": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  "description": {
                    "maxLength": 16384,
                    "type": "string"
                  },
                  "active_version": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  "package_digest": {
                    "minLength": 71,
                    "maxLength": 71,
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "manifest_digest": {
                    "minLength": 71,
                    "maxLength": 71,
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "runtime_target": {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "captured_at",
            "channel",
            "timezone",
            "capability_summary_ref"
          ],
          "properties": {
            "captured_at": {
              "minLength": 20,
              "maxLength": 35,
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
              "type": "string"
            },
            "channel": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "timezone": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            },
            "capability_summary_ref": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "version",
          "summary"
        ],
        "properties": {
          "ref": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "hash": {
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "maxLength": 16384,
            "type": "string"
          }
        }
      }
    },
    "source_status": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "source",
              "retrieved_at",
              "source_as_of",
              "source_version",
              "latency_ms",
              "result_count",
              "failure_reason",
              "status"
            ],
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "const": "knowthat",
                    "type": "string"
                  },
                  {
                    "const": "memory",
                    "type": "string"
                  },
                  {
                    "const": "skill",
                    "type": "string"
                  },
                  {
                    "const": "environment",
                    "type": "string"
                  },
                  {
                    "const": "history",
                    "type": "string"
                  }
                ]
              },
              "retrieved_at": {
                "minLength": 20,
                "maxLength": 35,
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                "type": "string"
              },
              "source_as_of": {
                "anyOf": [
                  {
                    "minLength": 20,
                    "maxLength": 35,
                    "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_version": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latency_ms": {
                "minimum": 0,
                "maximum": 300000,
                "type": "integer"
              },
              "result_count": {
                "minimum": 0,
                "maximum": 1000000,
                "type": "integer"
              },
              "failure_reason": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9_]*(?:[._-][a-z0-9_]+)*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "anyOf": [
                  {
                    "const": "ok",
                    "type": "string"
                  },
                  {
                    "const": "empty",
                    "type": "string"
                  },
                  {
                    "const": "timeout",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "type": "string"
                  },
                  {
                    "const": "degraded",
                    "type": "string"
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "source",
              "retrieved_at",
              "source_as_of",
              "source_version",
              "latency_ms",
              "result_count",
              "failure_reason",
              "status",
              "policy_id",
              "reason_code",
              "source_owner"
            ],
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "const": "knowthat",
                    "type": "string"
                  },
                  {
                    "const": "memory",
                    "type": "string"
                  },
                  {
                    "const": "skill",
                    "type": "string"
                  },
                  {
                    "const": "environment",
                    "type": "string"
                  },
                  {
                    "const": "history",
                    "type": "string"
                  }
                ]
              },
              "retrieved_at": {
                "minLength": 20,
                "maxLength": 35,
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                "type": "string"
              },
              "source_as_of": {
                "anyOf": [
                  {
                    "minLength": 20,
                    "maxLength": 35,
                    "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_version": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "maxLength": 512,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latency_ms": {
                "minimum": 0,
                "maximum": 300000,
                "type": "integer"
              },
              "result_count": {
                "minimum": 0,
                "maximum": 1000000,
                "type": "integer"
              },
              "failure_reason": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9_]*(?:[._-][a-z0-9_]+)*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "const": "skipped_by_policy",
                "type": "string"
              },
              "policy_id": {
                "minLength": 1,
                "maxLength": 512,
                "type": "string"
              },
              "reason_code": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_]*(?:[._-][a-z0-9_]+)*$",
                "type": "string"
              },
              "source_owner": {
                "minLength": 1,
                "maxLength": 512,
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "assembly_notes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(?:[._-][a-z0-9_]+)*$",
        "type": "string"
      }
    },
    "snapshot_hash": {
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
