{
  "name": "@pai/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "./policy/*": {
      "types": "./src/policy/*.ts",
      "default": "./dist/policy/*.js"
    },
    "./memory/*": {
      "types": "./src/memory/*.ts",
      "default": "./dist/memory/*.js"
    },
    "./knowthat/*": {
      "types": "./src/knowthat/*.ts",
      "default": "./dist/knowthat/*.js"
    },
    "./meta/*": {
      "types": "./src/meta/*.ts",
      "default": "./dist/meta/*.js"
    },
    "./skill-registry/*": {
      "types": "./src/skill-registry/*.ts",
      "default": "./dist/skill-registry/*.js"
    },
    "./trigger-processor/*": {
      "types": "./src/trigger-processor/*.ts",
      "default": "./dist/trigger-processor/*.js"
    },
    "./action-runtime/*": {
      "types": "./src/action-runtime/*.ts",
      "default": "./dist/action-runtime/*.js"
    },
    "./timer/*": {
      "types": "./src/timer/*.ts",
      "default": "./dist/timer/*.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate.mjs",
    "generate:check": "tsc -p tsconfig.json && node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
