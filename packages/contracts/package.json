{
  "name": "@pai/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "./policy/*": {
      "types": "./src/policy/*.ts",
      "default": "./dist/policy/*.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate.mjs",
    "generate:check": "tsc -p tsconfig.json && node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
